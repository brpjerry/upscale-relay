# Generated by prepare.py from the checked-out source, without network downloads.
pkgbase=upscale-relay
pkgname=(upscale-relay-common upscale-relay-client upscale-relay-server)
pkgver=@VERSION@
pkgrel=1
pkgdesc='Video upscaling on a GPU server, streamed to a player'
arch=('x86_64')
url='https://github.com/brpjerry/upscale-relay'
# The upstream repository does not currently declare a license.
license=('unknown')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=('upscale-relay.tar.gz')
sha256sums=('@SHA256@')

# installer writes into the build interpreter's versioned site-packages.
# Require a rebuild when Arch changes Python's minor version.
_python=('python>=@PYTHON_MIN@' 'python<@PYTHON_MAX@')

build() {
  local part
  for part in common client server; do
    (cd "$srcdir/upscale-relay/$part" && python -m build --wheel --no-isolation)
  done
}

package_upscale-relay-common() {
  pkgdesc='Shared protocol and media modules for Upscale Relay'
  arch=('any')
  depends=("${_python[@]}" 'python-av')
  cd "$srcdir/upscale-relay/common"
  python -m installer --destdir="$pkgdir" dist/*.whl
}

package_upscale-relay-client() {
  pkgdesc='Desktop and headless clients for Upscale Relay'
  arch=('any')
  depends=(
    "${_python[@]}" "upscale-relay-common=$pkgver-$pkgrel"
    'python-av' 'python-numpy' 'python-aiohttp' 'python-zeroconf'
    'pyside6' 'python-qasync' 'python-mpv' 'mpv' 'qt6-wayland' 'qt6-svg'
    'python-dbus-next'
  )
  cd "$srcdir/upscale-relay/client"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 upscale-relay-client.desktop \
    "$pkgdir/usr/share/applications/upscale-relay-client.desktop"
}

package_upscale-relay-server() {
  pkgdesc='Upscale Relay server: ONNX upscaling with TensorRT and NVENC'
  # CUDA and cuDNN come from Arch; relay-server --install-nvidia-runtime adds
  # the ONNX Runtime and TensorRT wheels no Arch package provides (Arch's
  # onnxruntime has no TensorRT provider). Those wheels link CUDA 13 by
  # soname, so a CUDA 14 cuda package waits for a new runtime stack.
  depends=(
    "${_python[@]}" "upscale-relay-common=$pkgver-$pkgrel"
    'python-av' 'python-numpy' 'python-aiohttp' 'python-zeroconf' 'python-onnx'
    # onnxruntime-gpu's own Python dependencies (installed --no-deps)
    'python-protobuf' 'python-flatbuffers' 'python-packaging'
    # installs the runtime
    'python-pip'
    # NVENC and display mapping (libplacebo on Vulkan)
    'ffmpeg' 'vulkan-icd-loader' 'nvidia-utils'
    'cudnn' 'libcudart.so=13-64' 'libcublas.so=13-64'
  )
  optdepends=(
    'upscale-relay-client: tray GUI (relay-server-gui), which wears the player'"'"'s theme'
  )
  install=upscale-relay-server.install
  cd "$srcdir/upscale-relay/server"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 upscale-relay-server.service \
    "$pkgdir/usr/lib/systemd/user/upscale-relay-server.service"
}
