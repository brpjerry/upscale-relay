# Generated by prepare.py from the checked-out source, without network downloads.
pkgname=upscale-relay-client
pkgver=@VERSION@
pkgrel=1
pkgdesc='Desktop and headless clients for Upscale Relay'
arch=('any')
url='https://github.com/brpjerry/upscale-relay'
# The upstream repository does not currently declare a license.
license=('unknown')
# installer writes into the build interpreter's versioned site-packages.
# Require a rebuild when Arch changes Python's minor version.
depends=(
  'python>=@PYTHON_MIN@' 'python<@PYTHON_MAX@'
  'python-av' 'python-numpy' 'python-aiohttp' 'python-zeroconf'
  'pyside6' 'python-qasync' 'python-mpv' 'mpv' 'qt6-wayland'
  'python-dbus-next'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=('client.tar.gz')
sha256sums=('@SHA256@')

build() {
  cd "$srcdir/client"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/client"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 upscale-relay-client.desktop \
    "$pkgdir/usr/share/applications/upscale-relay-client.desktop"
}
